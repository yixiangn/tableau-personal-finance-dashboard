      <aliases enabled='yes' />
      <column caption='Income Amount' datatype='real' default-format='C18441%' name='[Calculation_1729258370576384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [transaction_type] = &quot;Income&quot; AND [status] = &quot;Completed&quot; THEN [amount] ELSE 0 END' />
      </column>
      <column caption='Expense Amount' datatype='real' default-format='C18441%' name='[Calculation_1729258371162113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [transaction_type] = &quot;Expense&quot; AND [status] = &quot;Completed&quot; THEN [amount] ELSE 0 END' />
      </column>
      <column caption='Net Amount' datatype='real' default-format='C18441%' name='[Calculation_1729258374037506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;Completed&quot; THEN [signed_amount] ELSE 0 END' />
      </column>
      <column caption='Completed Transaction Count' datatype='string' name='[Calculation_1729258374516739]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [status] = &quot;Completed&quot; THEN [transaction_id] END' />
      </column>
      <column caption='Savings Rate' datatype='real' default-format='p0.0%' name='[Calculation_1729258375057412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_1729258370576384]) = 0 THEN 0 ELSE SUM([Calculation_1729258374037506])/SUM([Calculation_1729258370576384]) END' />
      </column>
      <column caption='Completed Transaction Count KPI' datatype='integer' name='[Calculation_1729258381049861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [status] = &quot;Completed&quot; THEN[transaction_id] END&#13;&#10;)' />
      </column>
      <column caption='Completed Expense Amount' datatype='real' name='[Calculation_2474177785065472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [transaction_type] = &quot;Expense&quot; AND [status] = &quot;Completed&quot;&#13;&#10;    THEN [amount] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Completed Expense Transaction ID' datatype='string' name='[Calculation_2474177787052033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [transaction_type] = &quot;Expense&quot; AND [status] = &quot;Completed&quot;&#13;&#10;    THEN [transaction_id]&#13;&#10;END' />
      </column>
      <column caption='Average Expense Amount' datatype='real' name='[Calculation_2474177788051458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([Calculation_2474177787052033]) = 0&#13;&#10;    THEN 0&#13;&#10;ELSE SUM([Calculation_2474177785065472])/ COUNTD([Calculation_2474177787052033])&#13;&#10;END' />
      </column>
      <column caption='Completed Income Amount' datatype='real' name='[Calculation_2474177814921219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [status] = &quot;Completed&quot; AND [transaction_type] = &quot;Income&quot;&#13;&#10;THEN [amount]&#13;&#10;ELSE   0&#13;&#10;END' />
      </column>
      <column caption='Completed Income Transaction ID' datatype='string' name='[Calculation_2474177815314437]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [status]= &quot;Completed&quot; AND [transaction_type] = &quot;Income&quot;&#13;&#10;THEN [transaction_id]&#13;&#10;END' />
      </column>
      <column caption='Completed Income Count KPI' datatype='integer' name='[Calculation_2474177815629830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2474177815314437])' />
      </column>
      <column caption='Average Income Amount' datatype='real' name='[Calculation_2474177815875591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([Calculation_2474177815314437]) = 0&#13;&#10;    THEN 0&#13;&#10;ELSE&#13;&#10;    SUM([Calculation_2474177814921219])/COUNTD([Calculation_2474177815314437])&#13;&#10;END' />
      </column>
      <column caption='Completed Net Savings' datatype='real' name='[Calculation_2474177816592392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2474177814921219])-SUM([Calculation_2474177785065472])' />
      </column>
      <column caption='Completed Savings Rate' datatype='real' name='[Calculation_2474177816854537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_2474177814921219])= 0&#13;&#10;    THEN 0&#13;&#10;ELSE &#13;&#10;    [Calculation_2474177816592392]/SUM([Calculation_2474177814921219])&#13;&#10;END' />
      </column>
      <column caption='Monthly Savings Rate' datatype='real' name='[Calculation_2474177826770955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_2474177814921219]) = 0 THEN 0&#13;&#10;ELSE SUM([Calculation_2474177826959372]) / SUM([Calculation_2474177814921219])&#13;&#10;END' />
